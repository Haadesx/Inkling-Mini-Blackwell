+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// One two-lane group per output row.  Each lane corresponds to one float2
+// iteration of the stock 32-lane kernel; preserve its pair of MADs and its
+// XOR reduction order, including the four additions of inactive +0 lanes.
+template<int K, int Q>
+static __global__ void mul_mat_vec_f_tiny_k(
+        const float * x, const float * y, float * dst, int rows) {
+    ggml_cuda_pdl_sync();
+    const int row = blockIdx.x * (blockDim.x / 2) + threadIdx.x / 2;
+    const int pair = threadIdx.x % 2;
+    const int batch = blockIdx.y;
+    float sums[Q] = {};
+    if (row < rows && pair < K / 2) {
+        const float2 xv = reinterpret_cast<const float2 *>(x + (int64_t(batch) * rows + row) * K)[pair];
+        #pragma unroll
+        for (int j = 0; j < Q; ++j) {
+            const float2 yv = reinterpret_cast<const float2 *>(y + (int64_t(batch) * Q + j) * K)[pair];
+            ggml_cuda_mad(sums[j], xv.x, yv.x);
+            ggml_cuda_mad(sums[j], xv.y, yv.y);
+        }
+    }
+    ggml_cuda_pdl_lc();
+    #pragma unroll
+    for (int j = 0; j < Q; ++j) {
+        // The stock XOR offsets 16, 8 and 4 each combine with +0.
+        sums[j] = __fadd_rn(sums[j], 0.0f);
+        sums[j] = __fadd_rn(sums[j], 0.0f);
+        sums[j] = __fadd_rn(sums[j], 0.0f);
+        // The original writes column j from lane j, not always lane zero.
+        // For j=2, offset 2 adds the active lanes to +0; j=1
+        // performs the last XOR addition in the opposite operand order.
+        sums[j] = j == 2 ? __fadd_rn(0.0f, sums[j]) : __fadd_rn(sums[j], 0.0f);
+        const float other = __shfl_xor_sync(0xffffffff, sums[j], 1);
+        sums[j] = j == 1 ? __fadd_rn(other, sums[j]) : __fadd_rn(sums[j], other);
+        if (pair == 0 && row < rows) dst[(int64_t(batch) * Q + j) * rows + row] = sums[j];
+    }
+}
+#endif
