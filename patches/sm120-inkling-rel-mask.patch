diff --git a/tests/inkling-rel-mask-smoke.cpp b/tests/inkling-rel-mask-smoke.cpp
new file mode 100644
index 0000000..102f5fc
--- /dev/null
+++ b/tests/inkling-rel-mask-smoke.cpp
@@ -0,0 +1,97 @@
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-cuda.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static int run_case(ggml_backend_t backend, int heads, int keys, int queries, int distances, bool with_nans) {
+    auto * ctx   = ggml_init({ 4*1024*1024, nullptr, true });
+    auto * table = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, heads, distances, queries);
+    auto * pos   = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, keys, queries);
+    auto * mask  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, keys, queries, 1, 1);
+
+    auto * original = ggml_get_rows(ctx, table, pos);
+    original = ggml_reshape_4d(ctx, original, heads, keys, queries, 1);
+    original = ggml_cont(ctx, ggml_permute(ctx, original, 2, 0, 1, 3));
+    original = ggml_cast(ctx, ggml_add(ctx, original, ggml_cast(ctx, mask, GGML_TYPE_F32)), GGML_TYPE_F16);
+    auto * fused = ggml_inkling_rel_mask(ctx, table, pos, mask);
+    if (!ggml_backend_supports_op(backend, fused)) {
+        std::fprintf(stderr, "backend does not support the custom op\n");
+        ggml_free(ctx);
+        return 4;
+    }
+
+    auto * graph = ggml_new_graph_custom(ctx, 128, false);
+    ggml_build_forward_expand(graph, original);
+    ggml_build_forward_expand(graph, fused);
+    auto buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (!buffer) {
+        ggml_free(ctx);
+        return 2;
+    }
+
+    std::vector<float> table_data((size_t) heads*distances*queries);
+    std::vector<int32_t> positions((size_t) keys*queries);
+    std::vector<ggml_fp16_t> masks(positions.size());
+    for (size_t i = 0; i < table_data.size(); ++i) {
+        table_data[i] = float(int((i*37) % 997) - 498)/37.0f;
+        if (with_nans && i % 173 == 0) table_data[i] = NAN;
+    }
+    for (size_t i = 0; i < positions.size(); ++i) {
+        positions[i] = (i*19) % distances;
+        const float values[] = { 0.0f, -INFINITY, -10000.0f, -0.0f, 0.25f, -0.5f };
+        masks[i] = ggml_fp32_to_fp16(values[i % 6]);
+    }
+    ggml_backend_tensor_set(table, table_data.data(), 0, table_data.size()*sizeof(float));
+    ggml_backend_tensor_set(pos, positions.data(), 0, positions.size()*sizeof(int32_t));
+    ggml_backend_tensor_set(mask, masks.data(), 0, masks.size()*sizeof(ggml_fp16_t));
+    if (ggml_backend_graph_compute(backend, graph) != GGML_STATUS_SUCCESS) {
+        ggml_backend_buffer_free(buffer);
+        ggml_free(ctx);
+        return 3;
+    }
+    ggml_backend_synchronize(backend);
+
+    std::vector<ggml_fp16_t> expected((size_t) heads*keys*queries), actual(expected.size());
+    ggml_backend_tensor_get(original, expected.data(), 0, expected.size()*sizeof(ggml_fp16_t));
+    ggml_backend_tensor_get(fused, actual.data(), 0, actual.size()*sizeof(ggml_fp16_t));
+    size_t mismatches = 0, nan_payload_diffs = 0;
+    for (size_t i = 0; i < expected.size(); ++i) {
+        if (expected[i] != actual[i]) {
+            if (std::isnan(ggml_fp16_to_fp32(expected[i])) && std::isnan(ggml_fp16_to_fp32(actual[i]))) {
+                ++nan_payload_diffs;
+            } else {
+                ++mismatches;
+            }
+        }
+    }
+    std::printf("H=%d K=%d Q=%d D=%d nan=%d: %s (%zu elements, %zu NaN payload differences)\n",
+                heads, keys, queries, distances, with_nans, mismatches ? "FAIL" : "PASS", expected.size(), nan_payload_diffs);
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+    return mismatches ? 1 : 0;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2 || (std::strcmp(argv[1], "cpu") && std::strcmp(argv[1], "cuda"))) {
+        std::fprintf(stderr, "usage: %s cpu|cuda\n", argv[0]);
+        return 2;
+    }
+    auto backend = std::strcmp(argv[1], "cpu") == 0 ? ggml_backend_cpu_init() : ggml_backend_cuda_init(0);
+    if (!backend) {
+        std::fprintf(stderr, "backend unavailable\n");
+        return 2;
+    }
+    int rc = 0;
+    for (int keys : { 1, 31, 41, 256, 1025 }) {
+        for (int heads : { 1, 5, 24 }) {
+            for (bool nans : { false, true }) rc |= run_case(backend, heads, keys, 128, 33, nans);
+        }
+    }
+    ggml_backend_free(backend);
+    return rc;
+}
