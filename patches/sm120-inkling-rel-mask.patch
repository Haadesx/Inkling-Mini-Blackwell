+// The custom callback is also the unique capability identity checked by CUDA.
+// The partition is over the contiguous output; no mutable userdata is required.
+static void ggml_inkling_rel_mask_cpu(struct ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(userdata);
+    const struct ggml_tensor * table = dst->src[0];
+    const struct ggml_tensor * ids = dst->src[1];
+    const struct ggml_tensor * mask = dst->src[2];
+    const float * t = (const float *) table->data;
+    const int32_t * p = (const int32_t *) ids->data;
+    const ggml_fp16_t * m = (const ggml_fp16_t *) mask->data;
+    ggml_fp16_t * o = (ggml_fp16_t *) dst->data;
+    const int64_t nk = ids->ne[0], nq = ids->ne[1], nh = table->ne[0], nd = table->ne[1];
+    const int64_t total = nk * nq * nh;
+    for (int64_t i = ith; i < total; i += nth) {
+        const int64_t key = i % nk, query = (i / nk) % nq, head = i / (nk * nq);
+        const int32_t distance = p[query * nk + key];
+        GGML_ASSERT(distance >= 0 && distance < nd);
+        const float bias = t[(query * nd + distance) * nh + head];
+        o[i] = GGML_FP32_TO_FP16(bias + GGML_FP16_TO_FP32(m[query * nk + key]));
+    }
+}
+
+bool ggml_is_inkling_rel_mask(const struct ggml_tensor * tensor) {
+    if (!tensor || tensor->op != GGML_OP_CUSTOM) return false;
+    struct ggml_custom_op_params params;
+    memcpy(&params, tensor->op_params, sizeof(params));
+    return params.fun == ggml_inkling_rel_mask_cpu && params.userdata == NULL;
+}
+
+struct ggml_tensor * ggml_inkling_rel_mask(struct ggml_context * ctx, struct ggml_tensor * table,
+                                           struct ggml_tensor * indices, struct ggml_tensor * mask) {
+    GGML_ASSERT(table->type == GGML_TYPE_F32 && indices->type == GGML_TYPE_I32 && mask->type == GGML_TYPE_F16);
+    GGML_ASSERT(ggml_is_contiguous(table) && ggml_is_contiguous(indices) && ggml_is_contiguous(mask));
+    GGML_ASSERT(table->ne[3] == 1 && indices->ne[2] == 1 && indices->ne[3] == 1 &&
+                mask->ne[2] == 1 && mask->ne[3] == 1 && table->ne[2] == indices->ne[1] &&
+                mask->ne[0] == indices->ne[0] && mask->ne[1] == indices->ne[1]);
+    struct ggml_tensor * args[] = {table, indices, mask};
+    return ggml_custom_4d(ctx, GGML_TYPE_F16, indices->ne[0], indices->ne[1], table->ne[0], 1,
+                          args, 3, ggml_inkling_rel_mask_cpu, GGML_N_TASKS_MAX, NULL);
+}
+
 struct ggml_tensor * ggml_custom_inplace(
         struct ggml_context * ctx,
         struct ggml_tensor  * a,
