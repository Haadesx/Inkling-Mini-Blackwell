+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static bool ggml_cuda_inkling_rel_mask_supported(const ggml_tensor * dst) {
+    if (!ggml_is_inkling_rel_mask(dst) || !dst->src[0] || !dst->src[1] || !dst->src[2] || dst->src[3]) return false;
+    const auto * t = dst->src[0]; const auto * p = dst->src[1]; const auto * m = dst->src[2];
+    return t->type == GGML_TYPE_F32 && p->type == GGML_TYPE_I32 && m->type == GGML_TYPE_F16 && dst->type == GGML_TYPE_F16 &&
+        ggml_is_contiguous(t) && ggml_is_contiguous(p) && ggml_is_contiguous(m) && ggml_is_contiguous(dst) &&
+        t->ne[3] == 1 && p->ne[2] == 1 && p->ne[3] == 1 && m->ne[2] == 1 && m->ne[3] == 1 &&
+        t->ne[2] == p->ne[1] && m->ne[0] == p->ne[0] && m->ne[1] == p->ne[1] &&
+        dst->ne[0] == p->ne[0] && dst->ne[1] == p->ne[1] && dst->ne[2] == t->ne[0] && dst->ne[3] == 1;
+}
+
+static __global__ void ggml_cuda_inkling_rel_mask(const float * table, const int32_t * pos, const half * mask, half * out,
+                                                   int64_t nk, int64_t nq, int64_t nh, int64_t nd) {
+    ggml_cuda_pdl_sync();
+    const int64_t total = nk * nq * nh;
+    for (int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x; i < total; i += int64_t(gridDim.x) * blockDim.x) {
+        const int64_t key = i % nk, query = (i / nk) % nq, head = i / (nk * nq);
+        const int32_t d = pos[query * nk + key];
+        assert(d >= 0 && d < nd);
+        const float bias = table[(query * nd + d) * nh + head];
+        out[i] = __float2half_rn(__fadd_rn(bias, __half2float(mask[query * nk + key])));
+    }
+    ggml_cuda_pdl_lc();
+}
